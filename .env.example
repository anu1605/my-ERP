APP_NAME="Task Tracker"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata
APP_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=task_tracker
DB_USER=root
# Password of the MySQL user above. There is no default - the app will not
# connect until this is filled in with the real password.
DB_PASS=

SESSION_NAME=task_tracker_session
SESSION_LIFETIME=1209600

UPLOAD_MAX_BYTES=26214400
UPLOAD_DIR=storage/uploads

ZIP_MAX_ENTRIES=5000
ZIP_MAX_UNCOMPRESSED_BYTES=262144000
ZIP_MAX_ENTRY_BYTES=52428800
ZIP_MAX_RATIO=200
